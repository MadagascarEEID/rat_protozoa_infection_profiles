sp_range   <- apply(sp[, c("PC1","PC2")], 2, range)
arrow_mult <- min(
diff(site_range[,1]) / diff(sp_range[,1]),
diff(site_range[,2]) / diff(sp_range[,2])
) * 0.7
sp <- sp %>%
mutate(
PC1s = PC1 * arrow_mult,
PC2s = PC2 * arrow_mult,
vec_len = sqrt(PC1^2 + PC2^2)
)
# Label strongest vectors only
top_n <- 5
sp_lab <- sp %>% slice_max(vec_len, n = top_n)
p_full_loadings <- p_full +
geom_segment(
data = sp_lab,
aes(x = 0, y = 0, xend = PC1s, yend = PC2s),
inherit.aes = FALSE,
linewidth = 0.4,
alpha = 0.7
) +
ggrepel::geom_text_repel(
data = sp_lab,
aes(x = PC1s, y = PC2s, label = label),
inherit.aes = FALSE,
size = 3,
max.overlaps = Inf
)
print(p_full_loadings)
