## PCA (FULL matrix incl. uninfected) + plot with top-5 parasite loadings
# Build FULL host x otu matrix INCLUDING uninfected hosts
pmat_full <- G4_long_otu %>%
select(host_ID, otu_ID, link) %>%
tidyr::pivot_wider(names_from = otu_ID, values_from = link, values_fill = 0) %>%
tibble::column_to_rownames("host_ID") %>%
as.matrix()
# Align membership with matrix rownames
memb_host2 <- memb_host %>%
mutate(host_ID_chr = as.character(host_ID),
host_group = factor(host_group)) %>%
select(host_ID_chr, host_group)
common_hosts <- intersect(rownames(pmat_full), memb_host2$host_ID_chr)
pmat_full <- pmat_full[common_hosts, , drop = FALSE]
meta_pca <- memb_host2 %>%
filter(host_ID_chr %in% common_hosts) %>%
arrange(match(host_ID_chr, rownames(pmat_full)))
stopifnot(all(meta_pca$host_ID_chr == rownames(pmat_full)))
# Hellinger transform + PCA (vegan::rda)
pmat_hell <- decostand(pmat_full, method = "hellinger")
pca_full <- rda(pmat_hell)
# Site scores (hosts)
df_sites <- as.data.frame(scores(pca_full, display = "sites")) %>%
tibble::rownames_to_column("host_ID_chr") %>%
left_join(meta_pca, by = "host_ID_chr")
# Percent variance explained
eig <- eigenvals(pca_full)
var_expl <- eig / sum(eig)
pc1 <- round(100 * var_expl[1], 1)
pc2 <- round(100 * var_expl[2], 1)
# Base PCA plot
p_full <- ggplot(df_sites, aes(x = PC1, y = PC2, color = host_group)) +
geom_point(alpha = 0.85, size = 2) +
labs(
title = "PCA of host infection profiles (FULL matrix incl. uninfected)",
x = paste0("PC1 (", pc1, "%)"),
y = paste0("PC2 (", pc2, "%)"),
color = "host_group"
) +
theme_classic()
# Species (parasite) loadings
sp <- as.data.frame(scores(pca_full, display = "species")) %>%
tibble::rownames_to_column("otu_ID") %>%
mutate(otu_ID = as.character(otu_ID))
# If you have taxonomy labels, join here (optional).
# Expecting: G4_taxonomy with columns otu_ID + final_id
if (exists("G4_taxonomy")) {
sp <- sp %>%
mutate(otu_ID_num = suppressWarnings(as.numeric(otu_ID))) %>%
left_join(
G4_taxonomy %>% select(otu_ID, final_id),
by = c("otu_ID_num" = "otu_ID")
) %>%
mutate(label = ifelse(is.na(final_id),
otu_ID,
paste0(otu_ID, " (", final_id, ")")))
} else {
sp <- sp %>% mutate(label = otu_ID)
}
# Robust manual arrow scaling (no vegan::: calls)
site_range <- apply(df_sites[, c("PC1", "PC2")], 2, range)
sp_range   <- apply(sp[, c("PC1", "PC2")], 2, range)
arrow_mult <- min(
diff(site_range[, 1]) / diff(sp_range[, 1]),
diff(site_range[, 2]) / diff(sp_range[, 2])
) * 0.7
sp <- sp %>%
mutate(
PC1s = PC1 * arrow_mult,
PC2s = PC2 * arrow_mult,
vec_len = sqrt(PC1^2 + PC2^2)
)
# Keep TOP 5 loadings only (by vector length)
top_n <- 5
sp_lab <- sp %>% slice_max(vec_len, n = top_n)
# Final plot with top-5 loading arrows + labels
p_full_loadings <- p_full +
geom_segment(
data = sp_lab,
aes(x = 0, y = 0, xend = PC1s, yend = PC2s),
inherit.aes = FALSE,
linewidth = 0.6,
alpha = 0.9
) +
geom_text_repel(
data = sp_lab,
aes(x = PC1s, y = PC2s, label = label),
inherit.aes = FALSE,
size = 3.5,
max.overlaps = Inf
)
print(p_full_loadings)
## ---------- Loadings (top 5) with robust labels + arrows from (0,0) ----------
# 1) Get species scores and rename axes to PC1/PC2 (vegan uses RDA1/RDA2)
sp <- scores(pca_full, display = "species", choices = 1:2) %>%
as.data.frame() %>%
tibble::rownames_to_column("otu_colname")
colnames(sp)[colnames(sp) == "RDA1"] <- "PC1"
colnames(sp)[colnames(sp) == "RDA2"] <- "PC2"
# 2) Recover the ORIGINAL parasite column name as used in pmat_full (often "X123")
#    and also a numeric ID for matching taxonomy (works whether names are "123" or "X123")
sp <- sp %>%
mutate(
otu_ID_chr = otu_colname,                # keep exact column name (e.g., "X123")
otu_ID_num = readr::parse_number(otu_colname)  # extract numeric (123)
)
# 3) Join taxonomy using numeric ID (robust)
tax2 <- G4_taxonomy %>%
mutate(otu_ID_num = readr::parse_number(as.character(otu_ID))) %>%
select(otu_ID_num, final_id) %>%
distinct()
sp <- sp %>%
left_join(tax2, by = "otu_ID_num") %>%
mutate(
label = ifelse(is.na(final_id),
otu_ID_chr,                        # fallback: column name
paste0(otu_ID_chr, " (", final_id, ")"))
)
# 4) Scale arrows to the site-score space (robust manual scaling)
site_range <- apply(df_sites[, c("PC1","PC2")], 2, range, na.rm = TRUE)
sp_range   <- apply(sp[, c("PC1","PC2")], 2, range, na.rm = TRUE)
arrow_mult <- min(
diff(site_range[, "PC1"]) / diff(sp_range[, "PC1"]),
diff(site_range[, "PC2"]) / diff(sp_range[, "PC2"])
) * 0.7
sp <- sp %>%
mutate(
PC1s = PC1 * arrow_mult,
PC2s = PC2 * arrow_mult,
vec_len = sqrt(PC1^2 + PC2^2)
)
# 5) Keep EXACTLY top 5 (no ties)
sp_top <- sp %>% slice_max(vec_len, n = 5, with_ties = FALSE)
# 6) Plot: arrows start at (0,0) using x=0,y=0 OUTSIDE aes()
p_full_loadings <- p_full +
geom_segment(
data = sp_top,
aes(xend = PC1s, yend = PC2s),
x = 0, y = 0,
inherit.aes = FALSE,
linewidth = 0.7,
alpha = 0.9
) +
ggrepel::geom_text_repel(
data = sp_top,
aes(x = PC1s, y = PC2s, label = label),
inherit.aes = FALSE,
size = 3.5,
max.overlaps = Inf
)
print(p_full_loadings)
